name: Install app
on: workflow_dispatch
permissions:
  contents: write
jobs:
  install:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: |
          bash index.html
          rm index.html
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add -A
          git commit -m "Add app"
          git push
